// SPDX-License-Identifier: GPL-2.0-only
/*
 * Innioasis Y1 (MT6572) twenty-fourth-boot device tree (docs/planning/Y1-MTP-PLAN.md, M1 retried): the
 * twenty-third-boot tree unchanged.
 *
 * Twenty-third-boot description (docs/planning/Y1-CHARGE-MODE-PLAN.md, C1): the
 * twenty-first-boot tree unchanged (the charge-only mode is PID1).
 *
 * Twenty-first-boot description (docs/planning/Y1-DATA-PLAN.md, stage B2): the
 * twentieth-boot tree with the eMMC write guard's window, USRDATA (Y2DATA) only.
 *
 * Twentieth-boot description (docs/planning/Y1-POWER-PLAN.md, D2): the nineteenth-boot
 * tree unchanged (the power daemon is userspace).
 *
 * Nineteenth-boot description (docs/planning/Y1-REBORN-PLAN.md, stage R3): the
 * eighteenth-boot tree with the sound card named as Reborn expects: card "Y2Audio", its headphone pin
 * "Headphone" (pin switch "Headphone Switch").
 *
 * Eighteenth-boot description (docs/planning/Y1-REBORN-PLAN.md, stage R2): the
 * seventeenth-boot tree with the keys Reborn understands: the wheel's zones on their own input device
 * "Y2 navigation buttons" (play/pause, next, back, previous as KEY_PLAYPAUSE, KEY_RIGHT, KEY_BACK, KEY_LEFT)
 * and the centre button's device under the same name, so it is Select.
 *
 * Seventeenth-boot description (docs/planning/Y1-REBORN-PLAN.md, stage R1b): the
 * sixteenth-boot tree plus the GPU: the SPM power controller with only the MFG domain (the display domain
 * stays as LK left it), the GPU clocked from WHPLL at 500.5 MHz as stock, no OPP table, no MFG reset.
 *
 * Sixteenth-boot description (docs/planning/Y1-REBORN-PLAN.md, stage R1a): the
 * fifteenth-boot tree unchanged (CONFIG_PM is kernel config).
 *
 * Fifteenth-boot description (docs/planning/Y1-POWER-PLAN.md, stage D1): the
 * fourteenth-boot tree plus the MT6323 power controller (power-off through the RTC BBPU).
 *
 * Fourteenth-boot description (docs/planning/Y1-AUDIO-PLAN.md, stage C): the
 * thirteenth-boot tree plus the AW87559 speaker amplifier on I2C0, fed from the MT6323's HPOUT, with
 * switches for the headphones and the speaker.
 *
 * Thirteenth-boot description (docs/planning/Y1-AUDIO-PLAN.md, stage B): the
 * twelfth-boot tree plus headphone playback: the MT6572 AFE (DL1 -> ADDA), the MT6323 codec, a simple card.
 *
 * Twelfth-boot description (docs/planning/Y1-SMP-PLAN.md): the eleventh-boot tree
 * unchanged apart from the model; both CPUs and their enable-method come from mt6572-fork.dtsi.
 *
 * Eleventh-boot description (docs/planning/Y1-NETWORK-PLAN.md): the tenth-boot tree
 * unchanged apart from the model; the network gadget is kernel config.
 *
 * Tenth-boot description (docs/planning/Y1-SYSTEM-PLAN.md): the ninth-boot tree
 * unchanged apart from the model; the hand-over to the Y2's init is in PID1.
 *
 * Ninth-boot description (docs/planning/Y1-ROOTFS-PLAN.md): the eighth-boot tree
 * unchanged apart from the model; the root filesystem is mounted by PID1.
 *
 * Eighth-boot description (docs/planning/Y1-BACKLIGHT-PLAN.md): the seventh-boot
 * tree plus the backlight on MT6323 ISINK0/1 (the shared Y2 driver, never above LK's duty).
 *
 * Seventh-boot description (docs/planning/Y1-DISPLAY-PLAN.md, stage B): the
 * sixth-boot tree with the MediaTek DRM pipeline instead of LK's simple-framebuffer: OVL -> RDMA ->
 * COLOR -> BLS -> DSI with LK's panel adopted as initialised (no reset, no command, backlight untouched),
 * physical scan-out (no IOMMU).
 *
 * Sixth-boot description: the fifth-boot tree unchanged apart from the model; the register dump is in PID1.
 *
 * Fifth-boot description (docs/planning/Y1-CHARGING-PLAN.md, stage B): the
 * fourth-boot tree plus the MT6323 charger (the Y2's driver, PC port only, at most 450 mA, 4.175 V),
 * the Y1 USB budget source it charges from, and the PMIC wrapper's charger-block write policy.
 *
 * Third-boot description (docs/planning/Y1-THIRD-BOOT-PLAN.md): the second-boot
 * tree (clocks, pins, PMIC wrapper, read-only eMMC and microSD, wheel, centre button) plus USB in device
 * mode and the MT6323 AUXADC for read-only battery telemetry. Facts: docs/knowledge/y1-hardware.md.
 * Deliberately absent: power domains, display, audio, charger, USB host mode, every PMIC regulator but
 * VGP1 and VUSB (the two card supplies are fixed descriptions, not PMIC regulators).
 */
/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "mt6572-fork.dtsi"

/ {
	model = "Innioasis Y1 twenty-fourth-boot test";
	compatible = "innioasis,y1", "mediatek,mt6572";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		/* clk_ignore_unused: the clock driver must not gate the display clocks LK left running. */
		bootargs = "rdinit=/init earlycon console=ttyS0,921600n8 console=tty0 loglevel=8 ignore_loglevel panic=10 clk_ignore_unused";
		stdout-path = "serial0:921600n8";
	};

	/* As the first boot (confirmed there): stock System RAM; the 10 MiB at 0x9e000000 and the
	 * frame buffer stay out. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x1e000000>, <0x9ea00000 0x01200000>;
	};

	/*
	 * Not PMIC regulators: fixed descriptions of the card rails LK leaves on (stock: VEMC_3V3 at 3.3 V),
	 * so mtk-sd knows their voltage. Without a vmmc supply it accepts no card voltage at all (second
	 * boot run 1: "no support for card's volts"). Linux switches nothing here.
	 */
	emmc_vcc: regulator-emmc-vcc {
		compatible = "regulator-fixed";
		regulator-name = "emmc-vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/* Stock AudDrv: AFE at 0x11140000, IRQ 96 = SPI 64 level low, clock MT_CG_AUDIO_SW_CG. */
	afe: audio-controller@11140000 {
		compatible = "innioasis,y1-mt6572-afe";
		reg = <0x11140000 0x1000>;
		interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&topckgen CLK_TOP_AUDIO>;
		clock-names = "audio";
		#sound-dai-cells = <0>;
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "Y2Audio";
		simple-audio-card,widgets = "Headphone", "Headphone", "Speaker", "Speaker";
		/* Stock: the AW87559 is fed from the MT6323's headphone outputs. */
		simple-audio-card,routing = "Headphone", "HPOUT", "PA IN", "HPOUT", "Speaker", "PA OUT";
		simple-audio-card,pin-switches = "Headphone", "Speaker";
		simple-audio-card,aux-devs = <&speaker_amp>;

		simple-audio-card,cpu {
			sound-dai = <&afe>;
		};

		simple-audio-card,codec {
			sound-dai = <&mt6323_codec>;
		};
	};

	/* The configured USB budget, reported by the gadget (kernel/y1/usb-source.c). */
	usb_input: usb-input {
		compatible = "innioasis,y1-usb-input";
	};

	sd_vcc: regulator-sd-vcc {
		compatible = "regulator-fixed";
		regulator-name = "sd-vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&pio {
	/* Stock 3.0.2 tpd_probe: GPIO136 mode 4 (EINT2), direction input, pull enabled and up. On paris
	 * input-enable sets only the input buffer; input-schmitt-enable is what sets the direction to input
	 * (run 3: "tried to flag a GPIO set as output for IRQ"). */
	wheel_pins: wheel-pins {
		pins-irq {
			pinmux = <MT6572_PIN_136_BPI_BUS6__FUNC_EINT2>;
			input-enable;
			input-schmitt-enable;
			bias-pull-up;
		};
	};
};

&pwrap {
	/* Charger block writes only within the Y2's reviewed fields and values (policy.h). */
	innioasis,pmic-charger-policy;

	/* Not upstream mt6323.dtsi: that describes every regulator, and Linux may switch off any described,
	 * unused one. Only the power key and VGP1 exist here; the others stay as LK left them. */
	pmic: pmic {
		compatible = "mediatek,mt6323";
		/* Stock PMIC_EINT_SETTING: EINT16, level, active high. */
		interrupt-parent = <&pio>;
		interrupts = <16 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <2>;

		/* Read-only telemetry; the Y1 adds the charger input (VCDT, channel 4). */
		pmic_adc: adc {
			compatible = "mediatek,mt6323-auxadc";
			#io-channel-cells = <1>;
			innioasis,charger-input;
		};

		/*
		 * The Y2's charger with Y1 limits: no BC1.1 (every source is a PC port; 450 mA only once a
		 * PC has configured the gadget, 70 mA otherwise); 4.175 V; PMIC die derating; the PMIC
		 * charger watchdog. No pack temperature (BATON does not respond, charging plan section 9) and no
		 * power-off-to-charger path (no innioasis,rgu: LK's charging mode is unverified on the Y1).
		 */
		charger {
			compatible = "innioasis,y2-mt6323-charger";
			io-channels = <&pmic_adc 7>, <&pmic_adc 5>, <&pmic_adc 6>, <&pmic_adc 3>;
			io-channel-names = "battery-voltage", "baton", "isense", "pmic-temperature";
			power-supplies = <&usb_input>;
			innioasis,usb-budget-source;
			innioasis,max-charge-current-microamp = <450000>;
		};

		/* The MT6323's audio codec, headphone path (the AW87559 speaker path is stage C). */
		mt6323_codec: codec {
			compatible = "innioasis,y1-mt6323-codec";
			#sound-dai-cells = <0>;
		};

		/* Stock lcd-backlight: MT6323 PMIC mode, ISINK0 and ISINK1 in parallel (display stage 0). */
		backlight {
			compatible = "innioasis,y2-backlight";
			innioasis,isink-mask = <0x3>;
		};

		/* Power-off only: BBPU 0x4300 and WRTGR 1 at power-off (no RTC driver). */
		power-controller {
			compatible = "mediatek,mt6323-pwrc";
		};

		keys {
			compatible = "mediatek,mt6323-keys";
			label = "Y2 navigation buttons";
			/* The centre button (the Y1 has no power button). */
			power {
				linux,keycodes = <KEY_ENTER>;
			};
		};

		regulators {
			compatible = "mediatek,mt6323-regulator";

			/* The wheel controller's supply; stock hwPowerOn(5, 3000, "TP"). */
			vgp1: ldo_vgp1 {
				regulator-name = "vgp1";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};

			/* The USB PHY's analogue supply; stock hwPowerOn(1, 3300, "VUSB_LDO") at USB init and
			 * never switched off. */
			vusb: ldo_vusb {
				regulator-name = "vusb";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};
		};
	};
};

/* The speaker amplifier only (stock: 0-0058 aw87559_pa). */
&i2c0 {
	status = "okay";
	clock-frequency = <100000>;

	/* Stock aw87559_i2c_probe: GPIO143 enables it; low, the default, it is off and does not answer. */
	speaker_amp: amplifier@58 {
		compatible = "awinic,aw87559";
		reg = <0x58>;
		enable-gpios = <&pio 143 GPIO_ACTIVE_HIGH>;
		sound-name-prefix = "PA";
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <100000>;

	wheel@51 {
		compatible = "innioasis,apt32f-wheel";
		reg = <0x51>;
		pinctrl-names = "default";
		pinctrl-0 = <&wheel_pins>;
		interrupt-parent = <&pio>;
		interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pio 134 GPIO_ACTIVE_LOW>;
		vdd-supply = <&vgp1>;
		/* reg3 bits 0-3: bottom, right, top, left (owner's getevent of stock 3.0.2). */
		linux,keycodes = <KEY_PLAYPAUSE KEY_RIGHT KEY_BACK KEY_LEFT>;
		/* Reborn takes select, back, left/right and play/pause only from this device name. */
		innioasis,zone-input-name = "Y2 navigation buttons";
	};
};

/*
 * Storage, read by the test PID1 only: no filesystem driver is built, PID1 sets each disk read-only
 * before reading. Conservative bus modes, no supplies (LK leaves them on), and empty pin states that
 * keep the preloader's pin setup (mtk-sd requires both states to exist).
 */
&mmc0 {
	status = "okay";
	/* The eMMC write guard (kernel/y1/emmc-guard.h): writes only to USRDATA, physical 0x4cf40000 (sector
	 * 0x267a00), 2 GiB (0x400000 sectors). PID1 makes the eMMC writable only when this window is present. */
	innioasis,emmc-write-window = <0x267a00 0x400000>;
	vmmc-supply = <&emmc_vcc>;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0;
	pinctrl-1;
	bus-width = <8>;
	max-frequency = <50000000>;
	cap-mmc-highspeed;
	non-removable;
	no-sd;
	no-sdio;
};

&mmc1 {
	status = "okay";
	vmmc-supply = <&sd_vcc>;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0;
	pinctrl-1;
	bus-width = <4>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	/* Card-detect pin unknown: probe once at boot (broken-cd polled every second and flooded the
	 * screen in run 1). A card must be inserted before power-on. */
	non-removable;
	no-1-8-v;
	no-mmc;
	no-sdio;
};

&uart0 {
	status = "okay";
};

/* Display stage B: physical scan-out, as LK; no IOMMU driver is built. */
&ovl {
	/delete-property/ iommus;
};

&rdma0 {
	/delete-property/ iommus;
};

/* In the path as a pass-through; its PWM driver is not built and the backlight comes from the MT6323. */
&bls {
	status = "okay";
};

&dsi {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* 6.18's mtk_dsi_host_attach finds its panel only through an OF graph (seventh boot run 1:
	 * "error -19: DSI attach" with a bare child node). */
	port {
		dsi_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};

	panel@0 {
		compatible = "innioasis,y1-lk-panel";
		reg = <0>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

/* Device mode only: no host mode, no role switch, nothing drives VBUS. PIO only (no DMA) by config. */
&usb {
	status = "okay";
	dr_mode = "peripheral";
};

&u2phy0 {
	status = "okay";
};

/*
 * Mainline's v1 T-PHY calibrates the slew rate with a frequency meter at sif + 0x100 (0x11110100); the
 * MT6572's meter is at 0x11110f00 (stock hs_slew_rate_cal). A fixed eye-src skips that calibration; 4
 * is what stock writes when its own calibration times out.
 */
&u2port0 {
	mediatek,eye-src = <4>;
	/* Third boot run 1: with only mainline's RG_VBUSVALID/RG_AVALID the controller stayed "not
	 * attached" while the PMIC measured 5.2 V on VCDT. Stock usb_phy_recover forces the whole session
	 * (U2PHYDTM1 |= 0x2e, SESSEND clear, force bits 9-13); patches-y1 0015 does the same on this flag. */
	innioasis,force-session-valid;
};

/* The display domain is LK's: Linux would power an unclaimed domain off at late init (dark screen). */
&spm {
	power-domain@MT6572_POWER_DOMAIN_DIS {
		status = "disabled";
	};
};

/*
 * Stock 3.0.2 runs this chip's GPU (eFuse 0x10009178 bit 27 = 0) from WHPLL at 500.5 MHz: mfg_mux_sel on
 * mfg_pre_500m, mfg_sel on the mux. WHPLL keeps LK's divider (500.5 MHz); no rate is set. Stock never uses the
 * MFG reset, and without an OPP table Lima's devfreq stays off.
 */
&gpu {
	/delete-property/ resets;
	assigned-clocks = <&topckgen CLK_TOP_MFG_MUX_SEL>, <&topckgen CLK_TOP_MFG_SEL>;
	assigned-clock-parents = <&topckgen CLK_TOP_MFG_PRE_500M>, <&topckgen CLK_TOP_MFG_MUX_SEL>;
};
