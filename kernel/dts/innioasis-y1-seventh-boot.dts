// SPDX-License-Identifier: GPL-2.0-only
/*
 * Innioasis Y1 (MT6572) seventh-boot device tree (docs/planning/Y1-DISPLAY-PLAN.md, stage B): the
 * sixth-boot tree with the MediaTek DRM pipeline instead of LK's simple-framebuffer: OVL -> RDMA ->
 * COLOR -> BLS -> DSI with LK's panel adopted as initialised (no reset, no command, backlight untouched),
 * physical scan-out (no IOMMU).
 *
 * Sixth-boot description: the fifth-boot tree unchanged apart from the model; the register dump is in PID1.
 *
 * Fifth-boot description (docs/planning/Y1-CHARGING-PLAN.md, stage B): the
 * fourth-boot tree plus the MT6323 charger (the Y2's driver, PC port only, at most 450 mA, 4.175 V),
 * the Y1 USB budget source it charges from, and the PMIC wrapper's charger-block write policy.
 *
 * Third-boot description (docs/planning/Y1-THIRD-BOOT-PLAN.md): the second-boot
 * tree (clocks, pins, PMIC wrapper, read-only eMMC and microSD, wheel, centre button) plus USB in device
 * mode and the MT6323 AUXADC for read-only battery telemetry. Facts: docs/knowledge/y1-hardware.md.
 * Deliberately absent: power domains, display, audio, charger, USB host mode, every PMIC regulator but
 * VGP1 and VUSB (the two card supplies are fixed descriptions, not PMIC regulators).
 */
/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "mt6572-fork.dtsi"

/ {
	model = "Innioasis Y1 seventh-boot test";
	compatible = "innioasis,y1", "mediatek,mt6572";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		/* clk_ignore_unused: the clock driver must not gate the display clocks LK left running. */
		bootargs = "rdinit=/init earlycon console=ttyS0,921600n8 console=tty0 loglevel=8 ignore_loglevel panic=10 clk_ignore_unused";
		stdout-path = "serial0:921600n8";
	};

	/* As the first boot (confirmed there): stock System RAM; the 10 MiB at 0x9e000000 and the
	 * frame buffer stay out. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x1e000000>, <0x9ea00000 0x01200000>;
	};

	/*
	 * Not PMIC regulators: fixed descriptions of the card rails LK leaves on (stock: VEMC_3V3 at 3.3 V),
	 * so mtk-sd knows their voltage. Without a vmmc supply it accepts no card voltage at all (second
	 * boot run 1: "no support for card's volts"). Linux switches nothing here.
	 */
	emmc_vcc: regulator-emmc-vcc {
		compatible = "regulator-fixed";
		regulator-name = "emmc-vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/* The configured USB budget, reported by the gadget (kernel/y1/usb-source.c). */
	usb_input: usb-input {
		compatible = "innioasis,y1-usb-input";
	};

	sd_vcc: regulator-sd-vcc {
		compatible = "regulator-fixed";
		regulator-name = "sd-vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&pio {
	/* Stock 3.0.2 tpd_probe: GPIO136 mode 4 (EINT2), direction input, pull enabled and up. On paris
	 * input-enable sets only the input buffer; input-schmitt-enable is what sets the direction to input
	 * (run 3: "tried to flag a GPIO set as output for IRQ"). */
	wheel_pins: wheel-pins {
		pins-irq {
			pinmux = <MT6572_PIN_136_BPI_BUS6__FUNC_EINT2>;
			input-enable;
			input-schmitt-enable;
			bias-pull-up;
		};
	};
};

&pwrap {
	/* Charger block writes only within the Y2's reviewed fields and values (policy.h). */
	innioasis,pmic-charger-policy;

	/* Not upstream mt6323.dtsi: that describes every regulator, and Linux may switch off any described,
	 * unused one. Only the power key and VGP1 exist here; the others stay as LK left them. */
	pmic: pmic {
		compatible = "mediatek,mt6323";
		/* Stock PMIC_EINT_SETTING: EINT16, level, active high. */
		interrupt-parent = <&pio>;
		interrupts = <16 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <2>;

		/* Read-only telemetry; the Y1 adds the charger input (VCDT, channel 4). */
		pmic_adc: adc {
			compatible = "mediatek,mt6323-auxadc";
			#io-channel-cells = <1>;
			innioasis,charger-input;
		};

		/*
		 * The Y2's charger with Y1 limits: no BC1.1 (every source is a PC port; 450 mA only once a
		 * PC has configured the gadget, 70 mA otherwise); 4.175 V; PMIC die derating; the PMIC
		 * charger watchdog. No pack temperature (BATON does not respond, charging plan section 9) and no
		 * power-off-to-charger path (no innioasis,rgu: LK's charging mode is unverified on the Y1).
		 */
		charger {
			compatible = "innioasis,y2-mt6323-charger";
			io-channels = <&pmic_adc 7>, <&pmic_adc 5>, <&pmic_adc 6>, <&pmic_adc 3>;
			io-channel-names = "battery-voltage", "baton", "isense", "pmic-temperature";
			power-supplies = <&usb_input>;
			innioasis,usb-budget-source;
			innioasis,max-charge-current-microamp = <450000>;
		};

		keys {
			compatible = "mediatek,mt6323-keys";
			/* The centre button (the Y1 has no power button). */
			power {
				linux,keycodes = <KEY_ENTER>;
			};
		};

		regulators {
			compatible = "mediatek,mt6323-regulator";

			/* The wheel controller's supply; stock hwPowerOn(5, 3000, "TP"). */
			vgp1: ldo_vgp1 {
				regulator-name = "vgp1";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};

			/* The USB PHY's analogue supply; stock hwPowerOn(1, 3300, "VUSB_LDO") at USB init and
			 * never switched off. */
			vusb: ldo_vusb {
				regulator-name = "vusb";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};
		};
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <100000>;

	wheel@51 {
		compatible = "innioasis,apt32f-wheel";
		reg = <0x51>;
		pinctrl-names = "default";
		pinctrl-0 = <&wheel_pins>;
		interrupt-parent = <&pio>;
		interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pio 134 GPIO_ACTIVE_LOW>;
		vdd-supply = <&vgp1>;
		/* reg3 bits 0-3: bottom, right, top, left (owner's getevent of stock 3.0.2). */
		linux,keycodes = <KEY_PLAYPAUSE KEY_NEXTSONG KEY_BACK KEY_PREVIOUSSONG>;
	};
};

/*
 * Storage, read by the test PID1 only: no filesystem driver is built, PID1 sets each disk read-only
 * before reading. Conservative bus modes, no supplies (LK leaves them on), and empty pin states that
 * keep the preloader's pin setup (mtk-sd requires both states to exist).
 */
&mmc0 {
	status = "okay";
	vmmc-supply = <&emmc_vcc>;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0;
	pinctrl-1;
	bus-width = <8>;
	max-frequency = <50000000>;
	cap-mmc-highspeed;
	non-removable;
	no-sd;
	no-sdio;
};

&mmc1 {
	status = "okay";
	vmmc-supply = <&sd_vcc>;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0;
	pinctrl-1;
	bus-width = <4>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	/* Card-detect pin unknown: probe once at boot (broken-cd polled every second and flooded the
	 * screen in run 1). A card must be inserted before power-on. */
	non-removable;
	no-1-8-v;
	no-mmc;
	no-sdio;
};

&uart0 {
	status = "okay";
};

/* Display stage B: physical scan-out, as LK; no IOMMU driver is built. */
&ovl {
	/delete-property/ iommus;
};

&rdma0 {
	/delete-property/ iommus;
};

/* In the path as a pass-through; its PWM driver is not built and the backlight comes from the MT6323. */
&bls {
	status = "okay";
};

&dsi {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* 6.18's mtk_dsi_host_attach finds its panel only through an OF graph (seventh boot run 1:
	 * "error -19: DSI attach" with a bare child node). */
	port {
		dsi_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};

	panel@0 {
		compatible = "innioasis,y1-lk-panel";
		reg = <0>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

/* Device mode only: no host mode, no role switch, nothing drives VBUS. PIO only (no DMA) by config. */
&usb {
	status = "okay";
	dr_mode = "peripheral";
};

&u2phy0 {
	status = "okay";
};

/*
 * Mainline's v1 T-PHY calibrates the slew rate with a frequency meter at sif + 0x100 (0x11110100); the
 * MT6572's meter is at 0x11110f00 (stock hs_slew_rate_cal). A fixed eye-src skips that calibration; 4
 * is what stock writes when its own calibration times out.
 */
&u2port0 {
	mediatek,eye-src = <4>;
	/* Third boot run 1: with only mainline's RG_VBUSVALID/RG_AVALID the controller stayed "not
	 * attached" while the PMIC measured 5.2 V on VCDT. Stock usb_phy_recover forces the whole session
	 * (U2PHYDTM1 |= 0x2e, SESSEND clear, force bits 9-13); patches-y1 0015 does the same on this flag. */
	innioasis,force-session-valid;
};
