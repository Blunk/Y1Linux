// SPDX-License-Identifier: GPL-2.0-only
/*
 * Innioasis Y1 (MT6572) second-boot device tree (docs/planning/Y1-SECOND-BOOT-PLAN.md): the first-boot
 * tree plus the MT6572 clock, pin and PMIC-wrapper drivers, read-only eMMC and microSD, the APT32F wheel
 * on I2C1 and the MT6323 power key (the centre button). Facts: docs/knowledge/y1-hardware.md.
 * Deliberately absent: power domains, display, USB, audio, battery, charger, every PMIC regulator but
 * VGP1 (the two card supplies are fixed descriptions, not PMIC regulators).
 */
/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "mt6572-fork.dtsi"

/ {
	model = "Innioasis Y1 second-boot test";
	compatible = "innioasis,y1", "mediatek,mt6572";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		/* clk_ignore_unused: the clock driver must not gate the display clocks LK left running. */
		bootargs = "rdinit=/init earlycon console=ttyS0,921600n8 console=tty0 loglevel=8 ignore_loglevel panic=10 clk_ignore_unused";
		stdout-path = "serial0:921600n8";

		framebuffer@9fc00000 {
			compatible = "simple-framebuffer";
			reg = <0x9fc00000 (480 * 360 * 2)>;
			width = <480>;
			height = <360>;
			stride = <(480 * 2)>;
			format = "r5g6b5";
		};
	};

	/* As the first boot (confirmed there): stock System RAM; the 10 MiB at 0x9e000000 and the
	 * frame buffer stay out. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x1e000000>, <0x9ea00000 0x01200000>;
	};

	/*
	 * Not PMIC regulators: fixed descriptions of the card rails LK leaves on (stock: VEMC_3V3 at 3.3 V),
	 * so mtk-sd knows their voltage. Without a vmmc supply it accepts no card voltage at all (second
	 * boot run 1: "no support for card's volts"). Linux switches nothing here.
	 */
	emmc_vcc: regulator-emmc-vcc {
		compatible = "regulator-fixed";
		regulator-name = "emmc-vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	sd_vcc: regulator-sd-vcc {
		compatible = "regulator-fixed";
		regulator-name = "sd-vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&pio {
	/* Stock 3.0.2 tpd_probe: GPIO136 mode 4 (EINT2), direction input, pull enabled and up. On paris
	 * input-enable sets only the input buffer; input-schmitt-enable is what sets the direction to input
	 * (run 3: "tried to flag a GPIO set as output for IRQ"). */
	wheel_pins: wheel-pins {
		pins-irq {
			pinmux = <MT6572_PIN_136_BPI_BUS6__FUNC_EINT2>;
			input-enable;
			input-schmitt-enable;
			bias-pull-up;
		};
	};
};

&pwrap {
	/* Not upstream mt6323.dtsi: that describes every regulator, and Linux may switch off any described,
	 * unused one. Only the power key and VGP1 exist here; the others stay as LK left them. */
	pmic: pmic {
		compatible = "mediatek,mt6323";
		/* Stock PMIC_EINT_SETTING: EINT16, level, active high. */
		interrupt-parent = <&pio>;
		interrupts = <16 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <2>;

		keys {
			compatible = "mediatek,mt6323-keys";
			/* The centre button (the Y1 has no power button). */
			power {
				linux,keycodes = <KEY_ENTER>;
			};
		};

		regulators {
			compatible = "mediatek,mt6323-regulator";

			/* The wheel controller's supply; stock hwPowerOn(5, 3000, "TP"). */
			vgp1: ldo_vgp1 {
				regulator-name = "vgp1";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};
		};
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <100000>;

	wheel@51 {
		compatible = "innioasis,apt32f-wheel";
		reg = <0x51>;
		pinctrl-names = "default";
		pinctrl-0 = <&wheel_pins>;
		interrupt-parent = <&pio>;
		interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pio 134 GPIO_ACTIVE_LOW>;
		vdd-supply = <&vgp1>;
		/* reg3 bits 0-3: bottom, right, top, left (owner's getevent of stock 3.0.2). */
		linux,keycodes = <KEY_PLAYPAUSE KEY_NEXTSONG KEY_BACK KEY_PREVIOUSSONG>;
	};
};

/*
 * Storage, read by the test PID1 only: no filesystem driver is built, PID1 sets each disk read-only
 * before reading. Conservative bus modes, no supplies (LK leaves them on), and empty pin states that
 * keep the preloader's pin setup (mtk-sd requires both states to exist).
 */
&mmc0 {
	status = "okay";
	vmmc-supply = <&emmc_vcc>;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0;
	pinctrl-1;
	bus-width = <8>;
	max-frequency = <50000000>;
	cap-mmc-highspeed;
	non-removable;
	no-sd;
	no-sdio;
};

&mmc1 {
	status = "okay";
	vmmc-supply = <&sd_vcc>;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0;
	pinctrl-1;
	bus-width = <4>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	/* Card-detect pin unknown: probe once at boot (broken-cd polled every second and flooded the
	 * screen in run 1). A card must be inserted before power-on. */
	non-removable;
	no-1-8-v;
	no-mmc;
	no-sdio;
};

&uart0 {
	status = "okay";
};
