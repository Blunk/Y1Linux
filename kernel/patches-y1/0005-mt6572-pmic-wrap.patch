@@ -1582,6 +1683,21 @@
 
 static int pwrap_regmap_write(void *context, u32 adr, u32 wdata)
 {
+	struct pmic_wrapper *wrp = context;
+	u32 old, mask;
+	int ret;
+
+	if (wrp->charger_policy && (adr <= Y2_PMIC_CHARGER_LAST ||
+				    (adr >= Y2_PMIC_ISINK_FIRST && adr <= Y2_PMIC_ISINK_LAST))) {
+		mask = y2_pmic_write_mask(adr);
+		if (!mask || !y2_pmic_value_allowed(adr, wdata))
+			return -EPERM;
+		ret = pwrap_read(wrp, adr, &old);
+		if (ret)
+			return ret;
+		if ((old ^ wdata) & ~mask)
+			return -EPERM;
+	}
 	return pwrap_write(context, adr, wdata);
 }
 
