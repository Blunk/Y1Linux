+#if IS_ENABLED(CONFIG_INNIOASIS_Y1_SLEEP)
+#include "/project/kernel/platform/pm-journal.h"
+/* Innioasis Y1 sleep (docs/planning/Y1-POWER-PLAN.md §18 D7b): the Y2's suspend backstop (its overlay 0037) on
+ * the RGU that LK leaves running and the watchdog core feeds (WATCHDOG_HANDLE_BOOT_ENABLED; nothing opens
+ * /dev/watchdog on the Y1). Upstream suspend stops the RGU only for an opened watchdog, so a sleep longer than
+ * its 15 s would end in a reset: the fed RGU is stopped and restarted like an opened one. While the backstop runs
+ * it owns the RGU and the core's pings are dropped, so a stalled step of a sleep resets the player (it has no
+ * power button) instead of hanging it until the battery is flat. */
+static struct mtk_wdt_dev *y1_backstop;
+static bool y1_backstop_owns;
+static bool y1_keepalive_running(struct watchdog_device *wdd)
+{
+	return y1_backstop && wdd == &y1_backstop->wdt_dev && watchdog_hw_running(wdd) &&
+		!READ_ONCE(y1_backstop_owns);
+}
+static int y1_backstop_start(unsigned int seconds)
+{
+	struct watchdog_device *wdd = &y1_backstop->wdt_dev;
+	unsigned int saved = wdd->timeout;
+	int ret;
+
+	if (watchdog_active(wdd) || seconds < WDT_MIN_TIMEOUT || seconds > WDT_MAX_TIMEOUT)
+		return -EBUSY;
+	WRITE_ONCE(y1_backstop_owns, true);
+	wdd->timeout = seconds;
+	ret = mtk_wdt_start(wdd);
+	wdd->timeout = saved;
+	if (!ret)
+		ret = mtk_wdt_ping(wdd);
+	if (ret)
+		WRITE_ONCE(y1_backstop_owns, false);
+	return ret;
+}
+static void y1_backstop_ping(void)
+{
+	mtk_wdt_ping(&y1_backstop->wdt_dev);
+}
+static void y1_backstop_stop(void)
+{
+	if (!watchdog_active(&y1_backstop->wdt_dev))
+		mtk_wdt_stop(&y1_backstop->wdt_dev);
+}
+/* The backstop is over: the core-fed RGU runs again at its own timeout. */
+static void y1_backstop_end(void)
+{
+	struct watchdog_device *wdd = &y1_backstop->wdt_dev;
+
+	WRITE_ONCE(y1_backstop_owns, false);
+	if (y1_keepalive_running(wdd)) {
+		mtk_wdt_start(wdd);
+		mtk_wdt_ping(wdd);
+	}
+}
+static const struct y2_pm_backstop_ops y1_backstop_ops = {
+	.start = y1_backstop_start, .ping = y1_backstop_ping, .stop = y1_backstop_stop,
+	.end = y1_backstop_end,
+};
+/* The core's ping; the backstop pings mtk_wdt_ping itself. */
+static int y1_wdt_ping(struct watchdog_device *wdd)
+{
+	if (READ_ONCE(y1_backstop_owns))
+		return 0;
+	return mtk_wdt_ping(wdd);
+}
+static const struct watchdog_ops y1_wdt_ops = {
+	.owner		= THIS_MODULE,
+	.start		= mtk_wdt_start,
+	.stop		= mtk_wdt_stop,
+	.ping		= y1_wdt_ping,
+	.set_timeout	= mtk_wdt_set_timeout,
+	.set_pretimeout	= mtk_wdt_set_pretimeout,
+	.restart	= mtk_wdt_restart,
+};
+static bool y1_sleep_wdt(struct device *dev)
+{
+	return of_device_is_compatible(dev->of_node, "mediatek,mt6572-wdt") &&
+		of_machine_is_compatible("innioasis,y1");
+}
+#else
+static bool y1_keepalive_running(struct watchdog_device *wdd)
+{
+	return false;
+}
+#endif
