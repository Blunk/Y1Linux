+/* ONLINE of the VBUS supply: 1 or 0, or negative while unknown (not registered yet, unreadable). */
+static int mtk_musb_vbus_online(struct mtk_glue *glue)
+{
+	struct power_supply *psy = power_supply_get_by_name(glue->vbus_supply);
+	union power_supply_propval val;
+	int ret;
+
+	if (!psy)
+		return -ENODEV;
+	ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_ONLINE, &val);
+	power_supply_put(psy);
+	return ret ? ret : !!val.intval;
+}
+
+static void mtk_musb_vbus_connect(struct mtk_glue *glue)
+{
+	int ret = pm_runtime_resume_and_get(glue->dev);
+
+	if (ret) {
+		dev_err(glue->dev, "VBUS present: clocks not enabled: %d\n", ret);
+		return;
+	}
+	ret = phy_power_on(glue->phy);
+	if (ret) {
+		pm_runtime_put(glue->dev);
+		dev_err(glue->dev, "VBUS present: PHY not powered on: %d\n", ret);
+		return;
+	}
+	glue->vbus_vote = true;
+	dev_info(glue->dev, "VBUS present: USB clocks on, session forced\n");
+}
+
+static void mtk_musb_vbus_disconnect(struct mtk_glue *glue)
+{
+	phy_power_off(glue->phy);
+	glue->vbus_vote = false;
+	pm_runtime_put(glue->dev);
+	dev_info(glue->dev, "VBUS gone: session ended, USB clocks off once MUSB suspends\n");
+}
+
+static void mtk_musb_vbus_work(struct work_struct *work)
+{
+	struct mtk_glue *glue = container_of(work, struct mtk_glue, vbus_work);
+	int online = mtk_musb_vbus_online(glue);
+
+	if (online < 0)
+		return;
+	mutex_lock(&glue->vbus_lock);
+	if (glue->vbus_ready && online != glue->vbus_vote) {
+		if (online)
+			mtk_musb_vbus_connect(glue);
+		else
+			mtk_musb_vbus_disconnect(glue);
+		/* MUSB's session check (and so its runtime-PM reference) runs from irq_work; a wall
+		 * charger or a cable pulled before enumeration raises no interrupt that would queue it. */
+		schedule_delayed_work(&glue->musb->irq_work, msecs_to_jiffies(100));
+	}
+	mutex_unlock(&glue->vbus_lock);
+}
+
+static int mtk_musb_vbus_notify(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct mtk_glue *glue = container_of(nb, struct mtk_glue, vbus_nb);
+	struct power_supply *psy = data;
+
+	if (event == PSY_EVENT_PROP_CHANGED && !strcmp(psy->desc->name, glue->vbus_supply))
+		schedule_work(&glue->vbus_work);
+	return NOTIFY_OK;
+}
+
+static void mtk_musb_vbus_start(struct mtk_glue *glue)
+{
+	int ret;
+
+	mutex_lock(&glue->vbus_lock);
+	glue->vbus_ready = true;
+	mutex_unlock(&glue->vbus_lock);
+	glue->vbus_nb.notifier_call = mtk_musb_vbus_notify;
+	ret = power_supply_reg_notifier(&glue->vbus_nb);
+	if (ret)
+		dev_err(glue->dev, "VBUS supply %s not followed: %d\n", glue->vbus_supply, ret);
+	schedule_work(&glue->vbus_work);
+}
+
+/* Back to the state mtk_musb_exit expects: the vote held and the PHY on. */
+static void mtk_musb_vbus_stop(struct mtk_glue *glue)
+{
+	power_supply_unreg_notifier(&glue->vbus_nb);
+	cancel_work_sync(&glue->vbus_work);
+	mutex_lock(&glue->vbus_lock);
+	glue->vbus_ready = false;
+	if (!glue->vbus_vote)
+		mtk_musb_vbus_connect(glue);
+	mutex_unlock(&glue->vbus_lock);
+}
