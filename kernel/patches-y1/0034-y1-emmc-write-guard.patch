+/* The partition a CMD6 to PARTITION_CONFIG selects, or -1 for any other request. */
+static int y1_partition_switch(const struct mmc_command *cmd)
+{
+	if (cmd->opcode != 6 || ((cmd->arg >> 16) & 0xff) != 179)
+		return -1;
+	return (cmd->arg >> 8) & 7;
+}
+
+/* 1 when the guard lets the request reach the card. A switch away from the user area counts at once;
+ * back to it only once it succeeded (msdc_request_done), so a failed switch never re-opens writes. */
+static bool y1_guard_request(struct msdc_host *host, struct mmc_request *mrq)
+{
+	struct mmc_card *card = mmc_from_priv(host)->card;
+	struct mmc_data *data = mrq->data;
+	struct y1_emmc_request r = {
+		.opcode = mrq->cmd->opcode, .arg = mrq->cmd->arg,
+		.has_data = !!data, .write = data && (data->flags & MMC_DATA_WRITE),
+		.blocks = data ? data->blocks : 0, .blksz = data ? data->blksz : 0,
+		.has_sbc = !!mrq->sbc, .sbc_arg = mrq->sbc ? mrq->sbc->arg : 0,
+		.partition = host->y1_partition,
+		.part_config = card ? card->ext_csd.part_config : 0,
+		.blockaddr = card && mmc_card_blockaddr(card),
+		.window_start = host->y1_window[0], .window_sectors = host->y1_window[1],
+	};
+	int partition;
+
+	if (!y1_emmc_request_allowed(&r)) {
+		host->y1_refused++;
+		dev_warn_ratelimited(host->dev, "y1 eMMC guard: refused CMD%u arg %#x (%u blocks, %s)\n",
+				     r.opcode, r.arg, r.blocks, r.write ? "write" : "no write");
+		return false;
+	}
+	partition = y1_partition_switch(mrq->cmd);
+	if (partition > 0)
+		host->y1_partition = partition;
+	return true;
+}
