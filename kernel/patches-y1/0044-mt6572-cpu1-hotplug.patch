@@ -12,6 +12,11 @@
 #include <linux/of_address.h>
 #include <linux/string.h>
 #include <linux/threads.h>
+#include <linux/delay.h>
+#include <linux/iopoll.h>
+#include <linux/stringify.h>
+#include <asm/cp15.h>
+#include <asm/smp_plat.h>
 
 #define MTK_MAX_CPU		8
 #define MTK_SMP_REG_SIZE	0x1000
@@ -143,8 +148,187 @@
 };
 CPU_METHOD_OF_DECLARE(mt81xx_tz_smp, "mediatek,mt81xx-tz-smp", &mt81xx_tz_smp_ops);
 
+#ifdef CONFIG_HOTPLUG_CPU
+/*
+ * MT6572 CPU1 hotplug with power-off (Innioasis Y1, docs/planning/Y1-POWER-PLAN.md
+ * D5), after stock's hotplug.c, mt-smp.c and spm_mtcmos_ctrl_cpu1(): the dying
+ * CPU leaves coherency and waits in WFI; CPU0 waits for the SPM to see that WFI
+ * and switches the CPU1 power domain (FC1) off. To come back, the boot ROM
+ * finds BOOT_SLV_CFG/ADDR and jumps to the kernel once FC1 is powered again.
+ * Stock's polls are unbounded; these are bounded, and a CPU1 left in an unknown
+ * state is not booted again.
+ */
+#define MT6572_SPM_BASE			0x10006000
+#define SPM_POWERON_CONFIG_SET		0x000
+#define SPM_FC1_PWR_CON			0x218
+#define SPM_CPU_FC1_L1_PDN		0x264
+#define SPM_PWR_STATUS			0x60c
+#define SPM_PWR_STATUS_S		0x610
+#define SPM_SLEEP_TIMER_STA		0x720
+#define SPM_REGISTER_KEY		(0x0b16 << 16 | 1)
+#define PWR_RST_B			BIT(0)
+#define PWR_ISO				BIT(1)
+#define PWR_ON				BIT(2)
+#define PWR_ON_S			BIT(3)
+#define PWR_CLK_DIS			BIT(4)
+#define SRAM_CKISO			BIT(5)
+#define SRAM_ISOINT_B			BIT(6)
+#define FC1_STATUS			BIT(11)
+#define APMCU1_SLEEP			BIT(16)
+#define FC1_L1_PDN			BIT(0)
+#define FC1_L1_PDN_ACK			BIT(8)
+#define BOOT_SLV_CFG			0x00
+#define BOOT_SLV_ADDR			0x04
+#define BOOT_SLV_CFG_ENABLE		0x13800001
+
+enum mt6572_cpu1_state { CPU1_FIRST_BOOT, CPU1_ON, CPU1_OFF, CPU1_UNKNOWN };
+static void __iomem *mt6572_spm;
+static enum mt6572_cpu1_state mt6572_cpu1 = CPU1_FIRST_BOOT;
+
+static void mt6572_fc1(u32 clear, u32 set)
+{
+	writel((readl(mt6572_spm + SPM_FC1_PWR_CON) & ~clear) | set, mt6572_spm + SPM_FC1_PWR_CON);
+}
+
+static int mt6572_spm_wait(u32 offset, u32 mask, u32 want)
+{
+	u32 value;
+
+	return readl_poll_timeout_atomic(mt6572_spm + offset, value, (value & mask) == want, 1, 10000);
+}
+
+static int mt6572_cpu1_power_on(void)
+{
+	writel(SPM_REGISTER_KEY, mt6572_spm + SPM_POWERON_CONFIG_SET);
+	mt6572_fc1(0, PWR_ON);
+	udelay(1);
+	mt6572_fc1(0, PWR_ON_S);
+	udelay(3);
+	if (mt6572_spm_wait(SPM_PWR_STATUS, FC1_STATUS, FC1_STATUS) ||
+	    mt6572_spm_wait(SPM_PWR_STATUS_S, FC1_STATUS, FC1_STATUS))
+		return -ETIMEDOUT;
+	writel(readl(mt6572_spm + SPM_CPU_FC1_L1_PDN) & ~FC1_L1_PDN, mt6572_spm + SPM_CPU_FC1_L1_PDN);
+	udelay(1);
+	if (mt6572_spm_wait(SPM_CPU_FC1_L1_PDN, FC1_L1_PDN_ACK, 0))
+		return -ETIMEDOUT;
+	mt6572_fc1(0, SRAM_ISOINT_B);
+	mt6572_fc1(PWR_CLK_DIS, 0);
+	mt6572_fc1(PWR_ISO, 0);
+	mt6572_fc1(0, PWR_CLK_DIS);
+	mt6572_fc1(SRAM_CKISO, 0);
+	mt6572_fc1(0, PWR_RST_B);
+	mt6572_fc1(PWR_CLK_DIS, 0);
+	return 0;
+}
+
+static int mt6572_boot_secondary(unsigned int cpu, struct task_struct *idle)
+{
+	int ret;
+
+	if (!mt6572_spm || mt6572_cpu1 == CPU1_FIRST_BOOT) {
+		ret = mtk_boot_secondary(cpu, idle);
+		if (!ret && mt6572_spm)
+			mt6572_cpu1 = CPU1_ON;
+		return ret;
+	}
+	if (mt6572_cpu1 != CPU1_OFF)
+		return -EIO;
+	writel(BOOT_SLV_CFG_ENABLE, mtk_smp_base + BOOT_SLV_CFG);
+	writel(__pa_symbol(secondary_startup_arm), mtk_smp_base + BOOT_SLV_ADDR);
+	ret = mt6572_cpu1_power_on();
+	if (ret) {
+		mt6572_cpu1 = CPU1_UNKNOWN;
+		pr_err("mt6572: CPU1 power-on timed out, FC1 %#x\n", readl(mt6572_spm + SPM_FC1_PWR_CON));
+		return ret;
+	}
+	mt6572_cpu1 = CPU1_ON;
+	return 0;
+}
+
+extern void v7_flush_dcache_louis(void);
+
+/*
+ * v7_exit_coherency_flush(louis) with the flush called through a register:
+ * clang's integrated assembler rejects the macro's "bl" in this file
+ * ("unsupported relocation type"). Same steps and clobbers: SCTLR.C off,
+ * clean and invalidate L1 to the point of unification, ACTLR.SMP off.
+ */
+static void mt6572_cpu_die(unsigned int cpu)
+{
+	asm volatile(
+	"mrc	p15, 0, r0, c1, c0, 0\n\t"
+	"bic	r0, r0, #" __stringify(CR_C) "\n\t"
+	"mcr	p15, 0, r0, c1, c0, 0\n\t"
+	"isb\n\t"
+	"blx	%0\n\t"
+	"mrc	p15, 0, r0, c1, c0, 1\n\t"
+	"bic	r0, r0, #(1 << 6)\n\t"
+	"mcr	p15, 0, r0, c1, c0, 1\n\t"
+	"isb\n\t"
+	"dsb"
+	: : "r" (v7_flush_dcache_louis)
+	: "r0", "r1", "r2", "r3", "r4", "r5", "r6", "r9", "r10", "ip", "lr", "memory");
+	for (;;) {
+		dsb();
+		wfi();
+	}
+}
+
+static int mt6572_cpu_kill(unsigned int cpu)
+{
+	if (!mt6572_spm || cpu != 1)
+		return 0;
+	writel(SPM_REGISTER_KEY, mt6572_spm + SPM_POWERON_CONFIG_SET);
+	if (mt6572_spm_wait(SPM_SLEEP_TIMER_STA, APMCU1_SLEEP, APMCU1_SLEEP)) {
+		mt6572_cpu1 = CPU1_UNKNOWN;
+		pr_err("mt6572: CPU1 never reached WFI, left powered\n");
+		return 0;
+	}
+	mt6572_fc1(0, PWR_CLK_DIS);
+	mt6572_fc1(0, SRAM_CKISO);
+	mt6572_fc1(0, PWR_ISO);
+	mt6572_fc1(SRAM_ISOINT_B, 0);
+	mt6572_fc1(PWR_RST_B, 0);
+	writel(readl(mt6572_spm + SPM_CPU_FC1_L1_PDN) | FC1_L1_PDN, mt6572_spm + SPM_CPU_FC1_L1_PDN);
+	if (mt6572_spm_wait(SPM_CPU_FC1_L1_PDN, FC1_L1_PDN_ACK, FC1_L1_PDN_ACK))
+		goto unknown;
+	mt6572_fc1(PWR_ON, 0);
+	udelay(1);
+	mt6572_fc1(PWR_ON_S, 0);
+	udelay(1);
+	if (mt6572_spm_wait(SPM_PWR_STATUS, FC1_STATUS, 0) || mt6572_spm_wait(SPM_PWR_STATUS_S, FC1_STATUS, 0))
+		goto unknown;
+	mt6572_cpu1 = CPU1_OFF;
+	return 1;
+unknown:
+	mt6572_cpu1 = CPU1_UNKNOWN;
+	pr_err("mt6572: CPU1 power-off timed out, FC1 %#x\n", readl(mt6572_spm + SPM_FC1_PWR_CON));
+	return 0;
+}
+
+static bool mt6572_cpu_can_disable(unsigned int cpu)
+{
+	return mt6572_spm && cpu == 1 && mt6572_cpu1 == CPU1_ON;
+}
+
+static void __init mt6572_smp_prepare_cpus(unsigned int max_cpus)
+{
+	mtk_smp_prepare_cpus(max_cpus);
+	if (mtk_smp_base && mtk_smp_info == &mtk_mt6572_boot)
+		mt6572_spm = ioremap(MT6572_SPM_BASE, 0x1000);
+}
+#endif
+
 static const struct smp_operations mt6589_smp_ops __initconst = {
+#ifdef CONFIG_HOTPLUG_CPU
+	.smp_prepare_cpus = mt6572_smp_prepare_cpus,
+	.smp_boot_secondary = mt6572_boot_secondary,
+	.cpu_die = mt6572_cpu_die,
+	.cpu_kill = mt6572_cpu_kill,
+	.cpu_can_disable = mt6572_cpu_can_disable,
+#else
 	.smp_prepare_cpus = mtk_smp_prepare_cpus,
 	.smp_boot_secondary = mtk_boot_secondary,
+#endif
 };
 CPU_METHOD_OF_DECLARE(mt6589_smp, "mediatek,mt6589-smp", &mt6589_smp_ops);
