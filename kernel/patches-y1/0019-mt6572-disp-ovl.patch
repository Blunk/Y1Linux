 struct mtk_disp_ovl {
 	struct drm_crtc			*crtc;
 	struct clk			*clk;
+	/*
+	 * Innioasis Y1: every clock of the node, OVL's own first. The others are blocks of the display path
+	 * that have no driver (SMI common and LARB0 for OVL's fetch, BLS between COLOR and DSI); they run
+	 * whenever OVL does, so they are off while the CRTC is (docs/planning/Y1-POWER-PLAN.md, D6 blocker B5).
+	 */
+	struct clk_bulk_data		*clks;
+	int				num_clks;
 	void __iomem			*regs;
 	struct cmdq_client_reg		cmdq_reg;
 	const struct mtk_disp_ovl_data	*data;
@@ -246,14 +253,22 @@
 int mtk_ovl_clk_enable(struct device *dev)
 {
 	struct mtk_disp_ovl *ovl = dev_get_drvdata(dev);
+	int ret = clk_prepare_enable(ovl->clk);
 
-	return clk_prepare_enable(ovl->clk);
+	if (ret || ovl->num_clks < 2)
+		return ret;
+	ret = clk_bulk_prepare_enable(ovl->num_clks - 1, ovl->clks + 1);
+	if (ret)
+		clk_disable_unprepare(ovl->clk);
+	return ret;
 }
 
 void mtk_ovl_clk_disable(struct device *dev)
 {
 	struct mtk_disp_ovl *ovl = dev_get_drvdata(dev);
 
+	if (ovl->num_clks > 1)
+		clk_bulk_disable_unprepare(ovl->num_clks - 1, ovl->clks + 1);
 	clk_disable_unprepare(ovl->clk);
 }
 
