# Innioasis Y1 (MT6572) second-boot kernel: allnoconfig plus exactly these lines
# (docs/planning/Y1-SECOND-BOOT-PLAN.md). The first-boot fragment, plus the MT6572 clock, pin and
# PMIC-wrapper drivers (kernel/patches-y1), MT6323 keys and one regulator, I2C with the wheel, and
# read-only storage: MMC with its block driver but no filesystem, so nothing can be mounted.
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_AEABI=y
CONFIG_MMU=y
# CONFIG_SMP is not set
# CONFIG_HIGHMEM is not set
# CONFIG_ARM_LPAE is not set
# CONFIG_CPU_BIG_ENDIAN is not set
# CONFIG_THUMB2_KERNEL is not set
# CONFIG_ARM_VIRT_EXT is not set
# CONFIG_EFI is not set
# CONFIG_XIP_KERNEL is not set
CONFIG_AUTO_ZRELADDR=y
CONFIG_ARM_APPENDED_DTB=y
# CONFIG_ARM_ATAG_DTB_COMPAT is not set
CONFIG_KERNEL_GZIP=y
CONFIG_CMDLINE="rdinit=/init"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_LOCALVERSION="-y1-second-boot"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# CONFIG_SERIAL_8250_DMA is not set
CONFIG_SERIAL_EARLYCON=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_WATCHDOG=y
# Feed a watchdog LK left running until PID1 opens /dev/watchdog (allnoconfig turns the default off).
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_BINFMT_ELF=y
# CONFIG_BINFMT_SCRIPT is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/project/initramfs/y1-first-boot.list"
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# CONFIG_NET is not set
# CONFIG_MODULES is not set
# CONFIG_SWAP is not set
# CONFIG_CMA is not set
# CONFIG_KEXEC is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MTD is not set
# CONFIG_SPI is not set
# CONFIG_PM is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_ARM_ARCH_TIMER is not set
CONFIG_HZ_100=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_SECURITY is not set
# CONFIG_ARM_PATCH_PHYS_VIRT is not set
CONFIG_PHYS_OFFSET=0x80000000
CONFIG_VMSPLIT_3G=y
CONFIG_PAGE_OFFSET=0xC0000000
# CONFIG_ATAGS is not set
# CONFIG_DEBUG_LL is not set
# CONFIG_KVM is not set
# CONFIG_Y2_PLATFORM is not set
CONFIG_MACH_MT6572=y
CONFIG_COMMON_CLK_MT6572=y
CONFIG_PINCTRL_MT6572=y
CONFIG_RESET_CONTROLLER=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6323=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_INNIOASIS_APT32F=y
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_DEVTMPFS=y
