# Innioasis Y1 (MT6572) kernel: allnoconfig plus exactly these lines (tools/build/y1-build.sh), with the
# initramfs from initramfs/y1-production.list. Facts: docs/knowledge/y1-hardware.md; each subsystem's plan and
# hardware evidence in docs/planning/Y1-*-PLAN.md.
# - Platform: SMP for the MT6572's two Cortex-A7 (mainline's boot-ROM entry and key; LK already powers CPU1; no
#   hotplug, cpufreq or idle states), CONFIG_PM (runtime PM; no suspend), the kernel 1 MiB higher (TEXT_OFFSET
#   0x00108000, overlays 0038/0039, as stock's 0x80108000) for the connectivity core's reserved memory.
# - Storage and the Y2 userspace: what the Y2's armhf glibc userspace needs from the kernel (the subset of
#   production.config: VFP/NEON, futex, epoll and the other fd-based syscalls, scripts, ptys, sysctl), the mount
#   chain (VFAT, loop, ext4, overlay on tmpfs) and the eMMC write guard (overlay 0034, switched on by the device
#   tree).
# - Power: the power-supply class, the MT6323 charger with the Y1 USB budget source, mainline's MT6323 power-off
#   driver (RTC BBPU, with the Y2's patch 0027; no RTC driver, no RGU charger path).
# - Display: the MediaTek DRM driver (MMSYS, mutex, OVL, RDMA, COLOR, DSI, MIPI TX), the LK-panel stub and fbdev
#   emulation for the console (no IOMMU, no SMI driver, no display power domain; clk_ignore_unused stays on the
#   command line), the backlight class and the shared MT6323 ISINK backlight driver, /dev/mem for PID1's
#   read-only register dump (IO_STRICT_DEVMEM off), mainline's MediaTek power domains (the GPU domain only) and
#   Lima for the Mali-400 MP1.
# - Audio: ALSA, ASoC, the simple card and the Y1 AFE, MT6323 codec and AW87559 drivers (SND_SOC_Y1_AUDIO).
# - USB: the configfs gadget (ACM and ECM built by PID1, FunctionFS and POSIX message queues for umtprd's MTP), no
#   legacy g_cdc; the musb fix is overlay 0035 (the Y2's musb_ep_start).
# - Network: local sockets, IPv4 (no IPv6, no forwarding), AF_PACKET for wpa_supplicant and udhcpc.
# - Connectivity: the Bluetooth core with RFCOMM as the Y2 (HIDP/BNEP/RFCOMM-TTY off), RFKILL, UHID, the AES/CCM
#   ciphers SMP and BlueZ use, the Y1 connectivity owner (CONFIG_BT_INNIOASIS_Y1, overlays 0036/0037) and its
#   Wi-Fi (CONFIG_BT_INNIOASIS_Y1_WIFI, overlay 0040) with cfg80211 and the signed regulatory database.
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_AEABI=y
CONFIG_MMU=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
# CONFIG_SMP_ON_UP is not set
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_HIGHMEM is not set
# CONFIG_ARM_LPAE is not set
# CONFIG_CPU_BIG_ENDIAN is not set
# CONFIG_THUMB2_KERNEL is not set
# CONFIG_ARM_VIRT_EXT is not set
# CONFIG_EFI is not set
# CONFIG_XIP_KERNEL is not set
CONFIG_AUTO_ZRELADDR=y
CONFIG_ARM_APPENDED_DTB=y
# CONFIG_ARM_ATAG_DTB_COMPAT is not set
CONFIG_KERNEL_GZIP=y
CONFIG_CMDLINE="rdinit=/init"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_LOCALVERSION="-y1linux"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# CONFIG_SERIAL_8250_DMA is not set
CONFIG_SERIAL_EARLYCON=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_WATCHDOG=y
# Feed a watchdog LK left running until PID1 opens /dev/watchdog (allnoconfig turns the default off).
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
# PID1 and the Y1 overrides, then the installer from a Y2ROOT build (tools/build/y1_installer.py,
# docs/planning/Y1-RECOVERY-PLAN.md R4), generated by tools/build/y1-build.sh.
CONFIG_INITRAMFS_SOURCE="/project/initramfs/y1-production.list /build/installer/y1-installer.list"
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# CONFIG_MODULES is not set
# CONFIG_SWAP is not set
# CONFIG_CMA is not set
# CONFIG_KEXEC is not set
# CONFIG_MTD is not set
# CONFIG_SPI is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_ARM_ARCH_TIMER is not set
CONFIG_HZ_100=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_SECURITY is not set
# CONFIG_ARM_PATCH_PHYS_VIRT is not set
CONFIG_PHYS_OFFSET=0x80000000
CONFIG_VMSPLIT_3G=y
CONFIG_PAGE_OFFSET=0xC0000000
# CONFIG_ATAGS is not set
# CONFIG_DEBUG_LL is not set
# CONFIG_KVM is not set
# CONFIG_Y2_PLATFORM is not set
CONFIG_MACH_MT6572=y
CONFIG_COMMON_CLK_MT6572=y
CONFIG_PINCTRL_MT6572=y
CONFIG_RESET_CONTROLLER=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6323=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_INNIOASIS_APT32F=y
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_DEVTMPFS=y
CONFIG_USB_SUPPORT=y
# CONFIG_USB is not set
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_MUSB_PIO_ONLY=y
# CONFIG_USB_INVENTRA_DMA is not set
CONFIG_NOP_USB_XCEIV=y
CONFIG_GENERIC_PHY=y
CONFIG_PHY_MTK_TPHY=y
# CONFIG_USB_G_SERIAL is not set
# CONFIG_U_SERIAL_CONSOLE is not set
CONFIG_IIO=y
CONFIG_INNIOASIS_MT6323_AUXADC=y
# CONFIG_THERMAL is not set
CONFIG_DEBUG_FS=y
CONFIG_POWER_SUPPLY=y
CONFIG_USB_PHY=y
CONFIG_CHARGER_INNIOASIS_MT6323=y
CONFIG_DEVMEM=y
# CONFIG_IO_STRICT_DEVMEM is not set
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# /dev/fb0 for the PID1 test pattern (allnoconfig leaves FB_DEVICE off; Y1-DISPLAY-PLAN.md, stage B run 2).
CONFIG_FB_DEVICE=y
CONFIG_MTK_MMSYS=y
CONFIG_DRM_MEDIATEK=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_DRM_PANEL_INNIOASIS_Y1_LK=y
# CONFIG_MTK_IOMMU is not set
# CONFIG_MTK_SMI is not set
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_INNIOASIS_MT6323=y
# The Y2 userspace is armv7 Thumb-2 glibc: allnoconfig turns Thumb user binaries off (Y1-ROOTFS-PLAN.md, run 1:
# the shell died silently), and the Y2's production.config also has KUSER_HELPERS.
CONFIG_ARM_THUMB=y
CONFIG_KUSER_HELPERS=y
# The Y2's glibc userspace uses the 32-bit-time syscalls (clock_nanosleep, ppoll, ...), which allnoconfig
# leaves out: Y1-SYSTEM-PLAN.md, run 2 strace, `clock_nanosleep(CLOCK_REALTIME, ...) = -1 ENOSYS`, so sleeps
# returned at once and init and crond spun. (Run 1 blamed HIGH_RES_TIMERS; it was not the cause. It stays
# off here: the periodic tick of every earlier Y1 boot is the qualified state.)
CONFIG_COMPAT_32BIT_TIME=y
# CONFIG_HIGH_RES_TIMERS is not set
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_PROC_SYSCTL=y
CONFIG_UNIX98_PTYS=y
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_OVERLAY_FS=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
# W5: AF_PACKET for wpa_supplicant's EAPOL and udhcpc (as the Y2)
CONFIG_PACKET=y
# CONFIG_IPV6 is not set
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_Y1_AUDIO=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_MT6323=y
CONFIG_PM=y
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
CONFIG_DRM_LIMA=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_MACH_MT6572_RESERVE_CONN=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_INNIOASIS_Y1=y
CONFIG_RFKILL=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=n
CONFIG_BT_HIDP=n
CONFIG_BT_BNEP=n
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_UHID=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_BT_INNIOASIS_Y1_WIFI=y
