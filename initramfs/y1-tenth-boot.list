# Innioasis Y1 tenth-boot initramfs (usr/gen_init_cpio list): the third-boot list plus the Y1 overrides
# for the Y2 system (initramfs/y1-system, docs/planning/Y1-SYSTEM-PLAN.md), which the test PID1 copies into
# the RAM overlay before handing over to the Y2's init.
dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
nod /dev/tty0 0620 0 0 c 4 0
nod /dev/watchdog 0600 0 0 c 10 130
dir /proc 0755 0 0
dir /sys 0755 0 0
file /init /build/y1-init 0755 0 0
dir /y1-system 0755 0 0
dir /y1-system/etc 0755 0 0
dir /y1-system/etc/init.d 0755 0 0
dir /y1-system/etc/default 0755 0 0
dir /y1-system/usr 0755 0 0
dir /y1-system/usr/libexec 0755 0 0
file /y1-system/etc/inittab /project/initramfs/y1-system/etc/inittab 0644 0 0
file /y1-system/etc/init.d/y1-services /project/initramfs/y1-system/etc/init.d/y1-services 0644 0 0
file /y1-system/etc/init.d/rcS /project/initramfs/y1-system/etc/init.d/rcS 0755 0 0
file /y1-system/etc/init.d/rcK /project/initramfs/y1-system/etc/init.d/rcK 0755 0 0
file /y1-system/etc/default/syslogd /project/initramfs/y1-system/etc/default/syslogd 0644 0 0
file /y1-system/usr/libexec/reborn-boot-services /project/initramfs/y1-system/usr/libexec/reborn-boot-services 0755 0 0
