# Innioasis Y1 override of the Y2's /etc/inittab (docs/planning/Y1-SYSTEM-PLAN.md, milestone A). The Y2's
# lines unchanged, plus a shell on the USB serial port: the Y1 has no other console a user can reach.
# Installed by the Y1 test PID1 into the RAM overlay; the Y2ROOT image is not modified.

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
::sysinit:/sbin/swapon -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts
::sysinit:/usr/libexec/reborn-boot-services

# Y1: a root shell on the USB serial gadget (no login; the image is read-only below a RAM overlay)
ttyGS0::respawn:/sbin/getty -n -l /bin/sh -L 0 ttyGS0 vt100

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
