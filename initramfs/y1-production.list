# Innioasis Y1 initramfs (usr/gen_init_cpio list, built into the kernel by kernel/config/y1-production.config):
# PID1 (y1-init) and the Y1 overrides PID1 installs over the Y2 root (/y1-system): the system's inittab, rcS/rcK
# and syslogd defaults (initramfs/y1-system), reborn-boot-services starting reborn-splash (initramfs/y1-splash),
# and each service with its list entry: Y2DATA at /data (initramfs/y1-data), the power daemon with the Y1 battery
# profile and policy (initramfs/y1-power), USB networking and SSH (initramfs/y1-network), Reborn and its audio
# profile for the Y1 card (initramfs/y1-reborn), MTP (initramfs/y1-mtp), Bluetooth and Wi-Fi (initramfs/
# y1-bluetooth: S41y2-connectivity, the radio firmware set, the service daemon's network-only policy).
# /dev/ttyS0 carries PID1's text. The authorised SSH key is the public half of out/y1-ssh/id_ed25519 (made per
# checkout, not committed): create it with
#   ssh-keygen -t ed25519 -N "" -C y1linux-dev -f out/y1-ssh/id_ed25519
dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
nod /dev/tty0 0620 0 0 c 4 0
nod /dev/ttyS0 0600 0 0 c 4 64
nod /dev/watchdog 0600 0 0 c 10 130
dir /proc 0755 0 0
dir /sys 0755 0 0
file /init /build/y1-init 0755 0 0
dir /y1-system 0755 0 0
dir /y1-system/etc 0755 0 0
dir /y1-system/etc/init.d 0755 0 0
dir /y1-system/etc/default 0755 0 0
dir /y1-system/usr 0755 0 0
dir /y1-system/usr/libexec 0755 0 0
file /y1-system/etc/inittab /project/initramfs/y1-system/etc/inittab 0644 0 0
file /y1-system/etc/init.d/y1-services /project/initramfs/y1-bluetooth/etc/init.d/y1-services 0644 0 0
file /y1-system/etc/init.d/S41y2-connectivity /project/initramfs/y1-bluetooth/etc/init.d/S41y2-connectivity 0755 0 0
file /y1-system/etc/init.d/S45y1-mtp /project/initramfs/y1-mtp/etc/init.d/S45y1-mtp 0755 0 0
file /y1-system/etc/init.d/rcS /project/initramfs/y1-system/etc/init.d/rcS 0755 0 0
file /y1-system/etc/init.d/rcK /project/initramfs/y1-system/etc/init.d/rcK 0755 0 0
file /y1-system/etc/default/syslogd /project/initramfs/y1-system/etc/default/syslogd 0644 0 0
file /y1-system/usr/libexec/reborn-boot-services /project/initramfs/y1-splash/usr/libexec/reborn-boot-services 0755 0 0
file /y1-system/etc/init.d/S50y1-dropbear /project/initramfs/y1-network/etc/init.d/S50y1-dropbear 0755 0 0
file /y1-system/etc/init.d/S90y1-reborn /project/initramfs/y1-reborn/etc/init.d/S90y1-reborn 0755 0 0
dir /y1-system/etc/y2linux 0755 0 0
file /y1-system/etc/y2linux/audio-enabled.json /project/initramfs/y1-reborn/etc/y2linux/audio-enabled.json 0644 0 0
file /y1-system/etc/init.d/S03y1-data /project/initramfs/y1-data/etc/init.d/S03y1-data 0755 0 0
file /y1-system/etc/y2linux/battery-profile.json /project/initramfs/y1-power/etc/y2linux/battery-profile.json 0644 0 0
file /y1-system/etc/y2linux/power-policy.json /project/initramfs/y1-power/etc/y2linux/power-policy.json 0644 0 0
file /y1-system/etc/y2linux/radio-firmware.json /project/initramfs/y1-bluetooth/etc/y2linux/radio-firmware.json 0644 0 0
file /y1-system/etc/y2linux/service-policy.json /project/initramfs/y1-bluetooth/etc/y2linux/service-policy.json 0644 0 0
dir /y1-system/data 0755 0 0
dir /y1-system/data/ssh 0755 0 0
dir /y1-system/data/ssh/authorized_keys.d 0700 0 0
file /y1-system/data/ssh/authorized_keys.d/authorized_keys /project/out/y1-ssh/id_ed25519.pub 0600 0 0
